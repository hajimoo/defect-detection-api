# --- Database (MySQL) Settings ---
# Docker Compose内のサービス名 'db' を指定
DB_HOST=db
DB_PORT=3306
DB_USER=root
# 実際のパスワードに変更してください
DB_PASSWORD=your_password
DB_NAME=ai_defect_detection

# MySQL初期化用設定 (DB_PASSWORD / DB_NAME と一致させること)
MYSQL_ROOT_PASSWORD=your_password
MYSQL_DATABASE=ai_defect_detection

# --- Redis Settings ---
# Docker Compose内のサービス名 'redis' を指定
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Security Settings ---
# 重要: 'openssl rand -hex 32' で生成した値を設定してください
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256

# --- CORS / Environment Settings ---
# ローカル開発環境用
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# AWS デプロイ時は以下のように切り替えてください
# ALLOWED_ORIGINS=http://your-ec2-ip,https://your-domain.com

